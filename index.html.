<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>İmam Hatip & Okul Yazılı Arenası</title>
<style>
:root{--bg:#0b1329;--panel:#16223f;--panel2:#1e2d53;--text:#f4f7ff;--muted:#b9c5dc;--accent:#38ef7d;--accent2:#11998e;--bad:#ff5e62}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at top,#1b2b50,#0b1329 60%);font-family:system-ui,Segoe UI,Arial,sans-serif;color:var(--text);padding:16px}
.wrap{max-width:900px;margin:auto}.brand{text-align:center;margin:10px 0 20px}.brand h1{font-size:clamp(1.8rem,5vw,3rem);margin:0;letter-spacing:-1px;color:#6ee7b7}.brand p{color:var(--muted);margin:6px 0}
.card{background:rgba(22,34,63,.97);border:1px solid #2a3d6c;border-radius:20px;padding:clamp(16px,4vw,28px);box-shadow:0 12px 40px rgba(0,0,0,.5)}
h2{margin-top:0}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
button,select{font:inherit}button{cursor:pointer;border:0;border-radius:12px;padding:12px 14px;font-weight:700;color:#0b1329;background:linear-gradient(135deg,#38ef7d,#11998e);transition:.15s}
button:hover{transform:translateY(-2px);filter:brightness(1.1)}button:focus-visible,select:focus-visible{outline:3px solid white;outline-offset:3px}
.choice{background:var(--panel2);color:var(--text);border:1px solid #364d80;text-align:left;min-height:55px;font-size:.95rem}.choice.selected{border:2px solid #38ef7d;background:#153f3a}
.primary{width:100%;margin-top:18px;font-size:1.05rem}.secondary{background:#3b4d75;color:white}.hidden{display:none!important}
label{display:block;font-weight:700;margin:14px 0 6px;color:#cbd5e1}select{width:100%;padding:12px;border-radius:10px;background:#0f172a;color:white;border:1px solid #3b5284}
.topline{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-weight:700;margin-bottom:14px}
.track{height:8px;background:#0b132a;border-radius:20px;overflow:hidden;margin:10px 0 20px}.fill{height:100%;width:0;background:#38ef7d;transition:width .25s}
.question{font-size:clamp(1.1rem,2.8vw,1.45rem);line-height:1.4;margin:10px 0 20px}
.answers{display:grid;gap:10px}.answer{background:#1f315a;color:white;text-align:left;border:1px solid #3b5488}.answer.correct{background:#134e3a;border-color:#38ef7d}.answer.wrong{background:#5a1f2c;border-color:var(--bad)}.answer:disabled{cursor:default;opacity:1}
.feedback{min-height:26px;margin-top:12px;font-weight:700}.actions{display:flex;gap:10px;margin-top:14px}.actions button{flex:1}
.result{text-align:center}.score{font-size:3.4rem;font-weight:900;color:#38ef7d;margin:6px}
.pill{display:inline-block;background:#1f315a;padding:6px 12px;border-radius:30px;color:var(--muted);margin:4px;font-size:.9rem}
footer{text-align:center;color:#8fa0bd;font-size:.85rem;margin:16px}
@media(max-width:520px){body{padding:10px}.actions{flex-direction:column}}
</style>
</head>
<body>
<div class="wrap">
<header class="brand">
  <h1>📚 İmam Hatip Yazılı Arenası</h1>
  <p>5, 6, 7, 8 ve 9. Sınıf Tüm Kültür ve Meslek Dersleri Soru Bankası</p>
</header>

<main class="card" id="setup">
  <h2>Sınav / Çalışma Modülü</h2>
  <p class="muted">Sınıfını ve çalışmak istediğin dersi seçerek yazılıya hazırlığa başla.</p>
  
  <label for="gradeSelect">Sınıf Seviyesi</label>
  <select id="gradeSelect">
    <option value="5">5. Sınıf</option>
    <option value="6">6. Sınıf</option>
    <option value="7">7. Sınıf</option>
    <option value="8">8. Sınıf</option>
    <option value="9">9. Sınıf</option>
  </select>

  <label>Ders Seçimi</label>
  <div class="grid" id="subjects"></div>

  <button class="primary" id="start">Yazılı Çalışmasını Başlat →</button>
  <p class="muted" style="font-size:.85rem; margin-top:14px;">* Her test rastgele 10 sorudan oluşur ve 10 dakika süre tanınır.</p>
</main>

<section class="card hidden" id="quiz">
  <div class="topline"><span id="quizInfo"></span><span id="timer">⏱ 10:00</span><span id="counter">1 / 10</span></div>
  <div class="track"><div class="fill" id="progress"></div></div>
  <div class="question" id="question"></div>
  <div class="answers" id="answers"></div>
  <div class="feedback" id="feedback" aria-live="polite"></div>
  <div class="actions"><button class="secondary" id="quit">Çalışmayı Bitir</button><button id="next" disabled>Sonraki Soru →</button></div>
</section>

<section class="card hidden result" id="result">
  <h2 id="resultTitle">Yazılı Çalışması Tamamlandı!</h2>
  <div class="score" id="score">0/10</div>
  <p id="resultText"></p>
  <div id="resultDetails"></div>
  <button class="primary" id="again">Yeni Ders / Test Seç</button>
</section>

<footer>© İmam Hatip Yazılı Arenası · Başarılar Dileriz!</footer>
</div>

