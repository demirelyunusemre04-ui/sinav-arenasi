let currentGrade = "5", currentSubject = "Kur'an-ı Kerim", questions = [], index = 0, score = 0, locked = false, seconds = 600, timerId = null;
const $ = id => document.getElementById(id);

function updateSubjects() {
  currentGrade = $("gradeSelect").value;
  const subjectsObj = db[currentGrade] || {};
  const names = Object.keys(subjectsObj);
  if(!names.includes(currentSubject)) currentSubject = names[0];
  
  $("subjects").innerHTML = names.map(s => 
    `<button class="choice ${s === currentSubject ? 'selected' : ''}" data-subject="${s}">📖 ${s}</button>`
  ).join("");
  
  $("subjects").querySelectorAll("button").forEach(b => {
    b.onclick = () => {
      currentSubject = b.dataset.subject;
      updateSubjects();
    }
  });
}

function startQuiz() {
  currentGrade = $("gradeSelect").value;
  const rawQuestions = (db[currentGrade] && db[currentGrade][currentSubject]) || [["Soru bulunamadı", ["A", "B", "C", "D"], 0]];
  questions = [...rawQuestions].sort(() => Math.random() - 0.5).slice(0, 10);
  index = 0; score = 0; seconds = 600; locked = false;
  
  $("setup").classList.add("hidden");
  $("result").classList.add("hidden");
  $("quiz").classList.remove("hidden");
  $("quizInfo").textContent = `${currentGrade}. Sınıf · ${currentSubject}`;
  
  showQuestion();
  clearInterval(timerId);
  timerId = setInterval(tick, 1000);
  updateTimer();
}

function tick() {
  seconds--;
  updateTimer();
  if(seconds <= 0) finishQuiz(true);
}

function updateTimer() {
  let m = Math.floor(seconds / 60), s = seconds % 60;
  $("timer").textContent = `⏱ ${m}:${String(s).padStart(2, "0")}`;
  if(seconds <= 60) $("timer").style.color = "var(--bad)";
  else $("timer").style.color = "var(--muted)";
}

function showQuestion() {
  locked = false;
  let q = questions[index];
  $("counter").textContent = `${index + 1} / ${questions.length}`;
  $("progress").style.width = `${(index / questions.length) * 100}%`;
  $("question").textContent = q[0];
  $("answers").innerHTML = q[1].map((a, i) => `<button class="answer">${String.fromCharCode(65 + i)}. ${a}</button>`).join("");
  $("answers").querySelectorAll("button").forEach((b, i) => b.onclick = () => chooseAnswer(i));
  $("feedback").textContent = "";
  $("next").disabled = true;
  $("next").textContent = index === questions.length - 1 ? "Sonuçları Göster →" : "Sonraki Soru →";
}

function chooseAnswer(chosen) {
  if(locked) return;
  locked = true;
  let correct = questions[index][2], buttons = $("answers").querySelectorAll("button");
  buttons.forEach((b, i) => {
    b.disabled = true;
    if(i === correct) b.classList.add("correct");
    if(i === chosen && i !== correct) b.classList.add("wrong");
  });
  if(chosen === correct) {
    score++;
    $("feedback").textContent = "✓ Doğru cevap, tebrikler!";
    $("feedback").style.color = "#38ef7d";
  } else {
    $("feedback").textContent = "✗ Yanlış. Doğru cevap: " + questions[index][1][correct];
    $("feedback").style.color = "var(--bad)";
  }
  $("next").disabled = false;
}

function nextQuestion() {
  if(!locked) return;
  if(index < questions.length - 1) {
    index++;
    showQuestion();
  } else {
    finishQuiz(false);
  }
}

function finishQuiz(timeout) {
  clearInterval(timerId);
  $("quiz").classList.add("hidden");
  $("result").classList.remove("hidden");
  $("score").textContent = score + " / " + questions.length;
  $("resultTitle").textContent = timeout ? "Süre Doldu!" : "Yazılı Çalışması Tamamlandı!";
  $("resultText").textContent = `${currentGrade}. Sınıf · ${currentSubject} testinde ${questions.length} sorudan ${score} tanesini doğru bildin.`;
  $("resultDetails").innerHTML = `<span class="pill">Doğru: ${score}</span><span class="pill">Yanlış/Boş: ${questions.length - score}</span><span class="pill">Başarı Notu: ${score * 10} Puan</span>`;
  $("progress").style.width = "100%";
}

$("gradeSelect").onchange = updateSubjects;
$("start").onclick = startQuiz;
$("next").onclick = nextQuestion;
$("quit").onclick = () => finishQuiz(false);
$("again").onclick = () => {
  $("result").classList.add("hidden");
  $("setup").classList.remove("hidden");
};

updateSubjects();
</script>
</body>
</html>
